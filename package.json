{
  "name": "cegs-theme",
  "description": "Custom theme for Centre for Eastern Ghats Studies (CEGS)",
  "demo": "",
  "version": "1.0.0",
  "keywords": ["ghost-theme", "cegs"],
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Antigravity",
    "email": "hello@example.com",
    "url": "https://example.com"
  },
  "config": {
    "posts_per_page": 10,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "custom": {
      "contact_form_endpoint": {
        "type": "text",
        "default": "https://formspree.io/f/placeholder",
        "group": "site"
      },
      "opportunity_form_endpoint": {
        "type": "text",
        "default": "https://formspree.io/f/placeholder",
        "group": "site"
      },
      "footer_contact_address": {
        "type": "text",
        "default": "123 Forest Road, Eastern Ghats",
        "group": "site"
      },
      "footer_contact_email": {
        "type": "text",
        "default": "contact@cegs.org",
        "group": "site"
      }
    }
  }
}
