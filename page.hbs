{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <div class="post-glass-content">
    {{#match @page.show_title_and_feature_image}}
    {{> "page-header"}}
    {{/match}}

    <div class="post-content editorial-layout drop-cap mt-5 mb-6">
        {{content}}
    </div>
    </div>
    
    {{> "dynamic-sections"}}
</article>
{{/post}}
