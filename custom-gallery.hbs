{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <div class="post-glass-content">
    {{> "page-header"}}

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
        {{content}}
    </div>

    <section class="gallery-categories-list" style="margin-top: 3rem; margin-bottom: 3rem;">
        {{#get "posts" filter="tag:gallery" limit="all" include="tags"}}
            {{#foreach posts}}
                <div class="gallery-category-section stagger-in" style="margin-bottom: var(--space-3);" data-post-id="{{id}}">
                    <div class="section-header mb-4" style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: var(--space-2);">
                        <div class="header-content" style="text-align: left;">
                            <h2 class="post-title" style="margin-bottom: 0; font-size: 1.8rem; line-height: 1;"><a href="{{url}}" style="color: var(--color-text); text-decoration: none;">{{title}}</a></h2>
                            {{#if custom_excerpt}}
                                <p class="text-muted mt-2 mb-0" style="font-size: 0.95rem;">{{custom_excerpt}}</p>
                            {{/if}}
                        </div>
                        
                        <div class="header-action" style="margin-bottom: 2px;">
                            <a href="{{url}}" class="read-more" style="display: inline-flex; align-items: center; color: var(--color-forest-green); font-size: 1rem; font-weight: 600; text-decoration: none; transition: opacity 0.2s ease;">
                                View More &rarr;
                            </a>
                        </div>
                    </div>
                    
                    <!-- Hidden raw content for JS parsing -->
                    <div class="raw-gallery-content" style="display: none;">
                        {{content}}
                    </div>
                    
                    <!-- Mini Grid to be populated by JS -->
                    <div class="mini-gallery-grid card-grid" style="display: grid; gap: var(--space-3);">
                        {{!-- Fallback if JS is disabled or fails --}}
                        <noscript>
                            <a href="{{url}}" style="grid-column: 1 / -1; text-align: center;">View Gallery</a>
                        </noscript>
                    </div>
                </div>
            {{else}}
                <p class="mono text-muted text-center" style="grid-column: 1 / -1; padding: var(--space-5);">No gallery categories found. Create a post with the tag "gallery".</p>
            {{/foreach}}
        {{/get}}
    </section>
    </div>
</article>
{{/post}}

{{#contentFor "scripts"}}
<script src="{{asset "js/gallery.js"}}" defer></script>
{{/contentFor}}
