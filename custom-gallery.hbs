{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
        {{content}}
    </div>

    <section class="gallery-section mt-8 mb-8">
        {{!-- CSS Masonry Grid --}}
        <div class="masonry-grid" id="masonry-gallery-container" style="column-count: 3; column-gap: var(--space-4);">
            <!-- Gallery items from tagged posts -->
            {{#get "posts" filter="tag:hash-gallery" limit="100"}}
                {{#foreach posts}}
                    {{#if feature_image}}
                    <div class="gallery-item mb-4" style="break-inside: avoid; position: relative; cursor: pointer; margin-bottom: var(--space-4);">
                        <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="gallery-img" style="width: 100%; border-radius: var(--radius-sm); display: block;" loading="lazy" />
                        
                        <div class="gallery-overlay" style="position: absolute; inset: 0; background: rgba(31, 42, 36, 0.8); color: white; display: flex; flex-direction: column; justify-content: flex-end; padding: var(--space-3); opacity: 0; transition: opacity 0.2s ease; border-radius: var(--radius-sm);">
                            <h3 style="font-family: var(--font-heading); font-size: 1.4em; margin-bottom: 4px; color: #F7F4EC; line-height: 1.2;">{{title}}</h3>
                            {{#if custom_excerpt}}
                            <div style="font-size: 0.85em; color: rgba(255,255,255,0.8); margin-top: 4px;">{{custom_excerpt}}</div>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}
                {{/foreach}}
            {{/get}}

            <!-- In-page gallery items will be injected here via JS -->
        </div>
    </section>
</article>

{{!-- Vanilla JS Lightbox --}}
<div id="lightbox" style="display: none; position: fixed; inset: 0; background: rgba(31, 42, 36, 0.95); z-index: 2000; align-items: center; justify-content: center; padding: var(--space-5);">
    <button id="lightbox-close" style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer;">&times;</button>
    <img id="lightbox-img" src="" alt="" style="max-width: 100%; max-height: 90vh; object-fit: contain; border-radius: 2px;" />
    <div id="lightbox-caption" class="mono" style="position: absolute; bottom: 20px; left: 20px; color: white; background: rgba(0,0,0,0.5); padding: 8px 16px; border-radius: 4px;"></div>
</div>

<style>
    .gallery-item:hover .gallery-overlay { opacity: 1 !important; }
    @media (max-width: 768px) { .masonry-grid { column-count: 2 !important; } }
    @media (max-width: 480px) { .masonry-grid { column-count: 1 !important; } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Parse Ghost Gallery Card and inject into masonry grid
        const rawGalleries = document.querySelectorAll('.post-content .kg-gallery-card, .post-content .kg-image-card');
        const masonryContainer = document.getElementById('masonry-gallery-container');
        
        if (masonryContainer && rawGalleries.length > 0) {
            rawGalleries.forEach(card => {
                let galleryCaptionStr = '';
                if (card.classList.contains('kg-gallery-card')) {
                    const galleryFigcaption = card.querySelector('figcaption');
                    if (galleryFigcaption) {
                        galleryCaptionStr = galleryFigcaption.innerHTML;
                    }
                }

                const images = card.querySelectorAll('img');
                images.forEach(img => {
                    const item = document.createElement('div');
                    item.className = 'gallery-item mb-4';
                    item.style.cssText = 'break-inside: avoid; position: relative; cursor: pointer; margin-bottom: var(--space-4);';
                    
                    const titleStr = img.alt || '';
                    let descStr = galleryCaptionStr;
                    
                    // If using individual image cards, extract description from figcaption
                    const figure = img.closest('figure.kg-image-card');
                    if (figure) {
                        const figcaption = figure.querySelector('figcaption');
                        if (figcaption) {
                            descStr = figcaption.innerHTML;
                        }
                    }

                    const overlayHtml = (titleStr || descStr) ? `
                        <div class="gallery-overlay" style="position: absolute; inset: 0; background: rgba(31, 42, 36, 0.8); color: white; display: flex; flex-direction: column; justify-content: flex-end; padding: var(--space-3); opacity: 0; transition: opacity 0.2s ease; border-radius: var(--radius-sm);">
                            ${titleStr ? `<h3 style="font-family: var(--font-heading); font-size: 1.4em; margin-bottom: 4px; color: #F7F4EC; line-height: 1.2;">${titleStr}</h3>` : ''}
                            ${descStr ? `<div style="font-family: ${titleStr ? 'inherit' : 'var(--font-heading)'}; font-size: ${titleStr ? '0.85em' : '1.4em'}; line-height: 1.2; color: rgba(255,255,255,0.9); margin-top: 4px;">${descStr}</div>` : ''}
                        </div>
                    ` : '';

                    item.innerHTML = `
                        <img src="${img.src}" alt="${titleStr}" class="gallery-img" style="width: 100%; border-radius: var(--radius-sm); display: block;" loading="lazy" />
                        ${overlayHtml}
                    `;
                    masonryContainer.appendChild(item);
                });
                
                // Hide the original Ghost card from normal flow
                card.style.display = 'none';
            });
        } else if (masonryContainer && rawGalleries.length === 0) {
            masonryContainer.innerHTML = '<p class="mono text-muted">Please add a Gallery card to this page to display images.</p>';
        }

        const items = document.querySelectorAll('.gallery-item');
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const closeBtn = document.getElementById('lightbox-close');
        
        items.forEach(item => {
            item.addEventListener('click', () => {
                const img = item.querySelector('.gallery-img');
                const title = item.querySelector('h3').innerText;
                
                lightboxImg.src = img.src;
                lightboxCaption.innerText = title;
                lightbox.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            });
        });
        
        function closeLightbox() {
            lightbox.style.display = 'none';
            lightboxImg.src = '';
            document.body.style.overflow = 'auto';
        }
        
        closeBtn.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', (e) => {
            if(e.target === lightbox) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
            if(e.key === 'Escape' && lightbox.style.display === 'flex') closeLightbox();
        });
    });
</script>
{{/post}}
