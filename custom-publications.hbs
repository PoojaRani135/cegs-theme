{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
        {{content}}
    </div>

    <section class="publications-list mt-8 mb-8">
        <div class="editorial-header" style="flex-wrap: wrap; gap: 16px;">
            <h2>Scientific Archive</h2>
            <div class="filter-controls" style="display: flex; gap: 8px;">
                <input type="text" id="pub-search" class="mono" placeholder="Search authors, titles, or types..." style="padding: 6px 12px; border: 1px solid var(--color-border); border-radius: 4px; background: transparent; color: var(--color-text-main); width: 250px;">
            </div>
        </div>

        <div class="publications-grid" style="display: flex; flex-direction: column; gap: var(--space-4);">
            {{#get "posts" filter="tag:publication" limit="all" include="tags"}}
                {{#foreach posts}}
                    {{!-- We assume custom_excerpt holds the citation metadata like "Journal of Ecology (2023)" --}}
                    {{!-- and the primary_tag name is used as the Type --}}
                    <div class="publication-item" data-search="{{title}} {{custom_excerpt}} {{authors autolink='false'}}" data-type="{{primary_tag.name}}" style="padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border);">
                        <div style="font-weight: 600; font-size: 1.1em; margin-bottom: 4px;">
                            <a href="{{url}}" style="color: var(--color-text-main); text-decoration: none;">{{title}}</a>
                        </div>
                        <div class="mono" style="color: var(--color-text-muted); font-size: 0.9em; margin-bottom: 8px;">
                            {{authors separator=", "}} &middot; <span style="font-style: italic;">{{custom_excerpt}}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="mono" style="font-size: 0.8em; text-transform: uppercase; letter-spacing: 1px; color: var(--color-accent-rust);">{{primary_tag.name}}</span>
                            <a href="{{url}}" class="mono" style="font-size: 0.85em; color: var(--color-accent);">Read &rarr;</a>
                        </div>
                    </div>
                {{else}}
                    <p class="mono text-muted">Publications will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</article>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('pub-search');
        const pubItems = document.querySelectorAll('.publication-item');
        
        function filterPubs() {
            const term = searchInput.value.toLowerCase();
            
            pubItems.forEach(item => {
                const searchData = item.getAttribute('data-search').toLowerCase();
                
                if(searchData.includes(term)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
        
        if(searchInput) searchInput.addEventListener('input', filterPubs);
    });
</script>
{{/post}}
