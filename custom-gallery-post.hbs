{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <div class="post-glass-content">
    {{> "page-header"}}

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center" style="display: none;">
        {{content}}
    </div>

    <section class="gallery-section mt-8 mb-8">
        {{!-- CSS Masonry Grid --}}
        <div class="masonry-grid" id="masonry-gallery-container">
            <!-- In-page gallery items will be injected here via JS -->
        </div>
    </section>
    </div>
</article>

{{!-- Vanilla JS Lightbox with Next/Prev --}}
<div id="lightbox" style="display: none; position: fixed; inset: 0; background: rgba(31, 42, 36, 0.95); z-index: 2000; align-items: center; justify-content: center; padding: var(--space-5);">
    <a id="lightbox-download" href="" download="image" style="position: absolute; top: 20px; right: 70px; background: none; border: none; color: white; padding: 4px; cursor: pointer; text-decoration: none; display: flex; align-items: center; justify-content: center; opacity: 0.8; transition: opacity 0.2s;" title="Download Image">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
    </a>
    <button id="lightbox-close" style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 2.5rem; line-height: 1; cursor: pointer; opacity: 0.8; transition: opacity 0.2s;">&times;</button>
    
    <!-- Prev Button -->
    <button id="lightbox-prev" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); border: none; color: white; font-size: 2rem; cursor: pointer; padding: 10px 15px; border-radius: 4px; z-index: 2001;">&#10094;</button>
    
    <img id="lightbox-img" src="" alt="" width="1200" height="800" style="max-width: 100%; max-height: 90vh; object-fit: contain; border-radius: 2px;" />
    
    <!-- Next Button -->
    <button id="lightbox-next" style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); border: none; color: white; font-size: 2rem; cursor: pointer; padding: 10px 15px; border-radius: 4px; z-index: 2001;">&#10095;</button>

    <div id="lightbox-caption" class="mono" style="position: absolute; bottom: 20px; left: 20px; color: white; background: rgba(0,0,0,0.5); padding: 8px 16px; border-radius: 4px;"></div>
</div>

{{/post}}

{{#contentFor "scripts"}}
<script src="{{asset "js/gallery-post.js"}}" defer></script>
{{/contentFor}}
