{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container mt-6 mb-8 page-case-story">
    {{#if feature_image}}
        <div class="post-fixed-background" style="background-image: url('{{img_url feature_image size="xl"}}');"></div>
        <script>document.body.classList.add('has-fixed-bg');</script>
    {{/if}}

    <div class="post-glass-content">
        <header class="post-header editorial-layout text-center mb-6">
            <h1 class="post-title editorial-title mt-2">{{title}}</h1>
        </header>

        <section class="post-content editorial-body case-story-content drop-cap editorial-layout">
            {{content}}
        </section>

        <div class="cta-section mt-8" style="text-align: center; max-width: var(--article-max-width); margin: 0 auto; padding-top: var(--space-6); border-top: 1px solid rgba(0,0,0,0.1);">
            <h3 style="margin-bottom: var(--space-3); font-family: var(--font-family-headings);">Explore the Research</h3>
            <p class="text-muted" style="margin-bottom: var(--space-4); text-align: center; font-family: var(--font-family-body); font-style: italic; font-size: 1.1rem;">See how we are studying and conserving this unique ecosystem.</p>
            <a href="/research/" class="btn btn-primary" style="display: inline-block;">View Research Projects</a>
        </div>
    </div>
</article>
{{/post}}
