<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    
    {{!-- Google Fonts --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:ital,wght@0,200..900;1,200..900" rel="stylesheet">
    
    {{!-- Main Stylesheet --}}
    <link rel="stylesheet" type="text/css" href="{{asset "css/tokens.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/components.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/post.css"}}" />
    
    {{!-- Swiper CSS --}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    {{ghost_head}}
    
    {{!-- Dynamic Site Background from Publication Cover --}}
    {{#if @site.cover_image}}
    <style>
        body {
            background-image: linear-gradient(rgba(245, 241, 232, 0.70), rgba(245, 241, 232, 0.70)), url({{@site.cover_image}});
            background-size: 100% auto;
            background-position: center calc(38px + var(--space-4) + var(--space-3));
            background-attachment: scroll;
            background-repeat: repeat;
        }
    </style>
    {{/if}}
</head>
<body class="{{body_class}}">
    {{!-- SVG Sprite Library for Foliage --}}
    {{> "svg-foliage"}}
    
    {{!-- Decorative Corner Frame (Only show if no custom cover image) --}}
    {{^if @site.cover_image}}
        {{> "living-frame"}}
    {{/if}}
    
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <div class="site-wrapper">
        {{> "site-header"}}
        
        <main id="main-content" class="site-main">
            {{{body}}}
        </main>
        
        {{> "site-footer"}}
    </div>
    
    {{!-- Main Javascript --}}
    <script src="{{asset "js/main.js"}}" defer></script>
    <script src="{{asset "js/dropdown-override.js"}}" defer></script>
    
    {{!-- External Libraries --}}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/fslightbox@3.4.2/index.js" defer></script>
    
    {{{block "scripts"}}}
    
    {{ghost_foot}}
</body>
</html>
