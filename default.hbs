<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    
    {{!-- Google Fonts --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    
    {{!-- Main Stylesheet --}}
    <link rel="stylesheet" type="text/css" href="{{asset "css/tokens.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/components.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/post.css"}}" />
    
    {{!-- Swiper CSS --}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    {{ghost_head}}
    
    {{!-- Dynamic Site Background from Publication Cover --}}
    {{#if @site.cover_image}}
    <style>
        body {
            background-image: linear-gradient(rgba(245, 241, 232, 0.70), rgba(245, 241, 232, 0.70)), url({{@site.cover_image}});
            background-size: 100% auto;
            background-position: center calc(38px + var(--space-4) + var(--space-3));
            background-attachment: scroll;
            background-repeat: repeat;
        }
    </style>
    {{/if}}
</head>
<body class="{{body_class}}">
    {{!-- SVG Sprite Library for Foliage --}}
    {{> "svg-foliage"}}
    
    {{!-- Decorative Corner Frame (Only show if no custom cover image) --}}
    {{^if @site.cover_image}}
        {{> "living-frame"}}
    {{/if}}
    
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <div class="site-wrapper">
        {{> "site-header"}}
        
        <main id="main-content" class="site-main">
            {{{body}}}
        </main>
        
        {{> "site-footer"}}
    </div>
    
    <button id="audio-toggle" class="audio-toggle" aria-label="Unmute ambient forest sound" data-state="muted">
        <span class="audio-hint-pulse"></span>
        <svg class="icon-speaker-muted" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
        <svg class="icon-speaker-playing" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
    </button>

    {{!-- Ambient Audio Element --}}
    <audio id="ambient-audio" loop preload="none">
        <source src="{{asset "media/forest-ambient.mp3"}}" type="audio/mpeg">
    </audio>

    {{!-- Main Javascript --}}
    <script src="{{asset "js/map-data.js"}}"></script>
    <script src="{{asset "js/main.js"}}"></script>
    <script src="{{asset "js/audio.js"}}"></script>
    <script src="{{asset "js/map.js"}}"></script>
    
    {{!-- External Libraries --}}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fslightbox@3.4.2/index.js"></script>
    
    {{{block "scripts"}}}
    
    {{ghost_foot}}
</body>
</html>
