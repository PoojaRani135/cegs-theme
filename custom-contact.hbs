{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
        {{content}}
    </div>

    

    <div class="writing-pad-wrapper">
        <div class="clipboard-clip"></div>
        <form action="{{@custom.contact_form_endpoint}}" method="POST" class="writing-pad">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required />
            </div>
            
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required />
            </div>

            <div class="form-group">
                <label for="subject">Subject</label>
                <input type="text" id="subject" name="subject" required />
            </div>
            
            <div class="form-group" style="margin-bottom: 0;">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required></textarea>
            </div>
            
            <div style="text-align: center; margin-top: 32px;">
                <button type="submit" class="stamp-button">Transmit Message</button>
            </div>
        </form>
    </div>
</article>
{{/post}}
