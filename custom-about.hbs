{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <div class="post-glass-content">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl" format="webp"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    {{!-- Two-Column Mission/Vision Layout --}}
    <div class="post-content editorial-layout drop-cap mt-5">
        {{content}}
    </div>
    </div>

    {{!-- Team Section: Stacked Structure --}}
    <div class="post-glass-content mt-8">
    <section class="team-section">
        <header class="post-header editorial-header text-center">
            <h2 class="post-title" style="margin-bottom: 0;">Our Team</h2>
        </header>
        
        <div class="team-sections mt-4">
            {{!-- Governing Body --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Governing Body</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-governing" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Research Team --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Research Team</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-research" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Advisory Committee --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Advisory Committee</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-advisory" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Collaborators --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Collaborators</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tags:[hash-team-collaborators,hash-team-collaborator]" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Dynamic Team Sections for any new #team-* tags --}}
            {{#get "tags" limit="100" filter="visibility:internal+slug:~^'hash-team-'+slug:-[hash-team,hash-team-governing,hash-team-research,hash-team-advisory,hash-team-collaborators,hash-team-collaborator]" as |custom_team_tags|}}
                {{#foreach custom_team_tags}}
                    {{#get "posts" filter="tag:{{slug}}" limit="100" include="tags"}}
                        {{#if posts}}
                        <div class="team-group dynamic-team-group" style="margin-bottom: var(--space-6);">
                            <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);" class="dynamic-team-title" data-tag-name="{{../name}}" data-tag-slug="{{../slug}}">{{../name}}</h3>
                            <div class="field-journal-grid">
                                {{#foreach posts}}
                                    {{> "card-team"}}
                                {{/foreach}}
                            </div>
                        </div>
                        {{/if}}
                    {{/get}}
                {{/foreach}}
            {{/get}}

        </div>
    </section>
    </div>
    {{> "dynamic-sections"}}
</article>

{{#contentFor "scripts"}}
<script>
    (function() {
        function formatDynamicTeamTitles() {
            var titles = document.querySelectorAll('.dynamic-team-title');
            titles.forEach(function(el) {
                var rawName = el.getAttribute('data-tag-name') || el.textContent || '';
                var slug = el.getAttribute('data-tag-slug') || '';

                // Strip leading #team- or hash-team- or #team
                var clean = rawName.replace(/^#?team[-_]?/i, '').replace(/^hash-team[-_]?/i, '');
                if (!clean && slug) {
                    clean = slug.replace(/^hash-team[-_]?/i, '');
                }

                if (clean) {
                    // Convert hyphens and underscores to spaces and capitalize each word
                    var formatted = clean
                        .split(/[-_]+/)
                        .filter(Boolean)
                        .map(function(word) {
                            return word.charAt(0).toUpperCase() + word.slice(1);
                        })
                        .join(' ');

                    if (formatted) {
                        el.textContent = formatted;
                    }
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', formatDynamicTeamTitles);
        } else {
            formatDynamicTeamTitles();
        }
    })();
</script>
{{/contentFor}}

{{/post}}

