{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <div class="post-glass-content">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl" format="webp"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    {{!-- Two-Column Mission/Vision Layout --}}
    <div class="post-content editorial-layout drop-cap mt-5">
        {{content}}
    </div>
    </div>

    {{!-- Team Section: Stacked Structure --}}
    <div class="post-glass-content mt-8">
    <section class="team-section">
        <header class="post-header editorial-header text-center">
            <h2 class="post-title" style="margin-bottom: 0;">Our Team</h2>
        </header>
        
        <div class="team-sections mt-4">
            {{!-- Governing Body --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Governing Body</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-governing" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Research Team --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Research Team</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-research" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Advisory Committee --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Advisory Committee</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-advisory" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

            {{!-- Collaborators --}}
            <div class="team-group" style="margin-bottom: var(--space-6);">
                <h3 style="margin-bottom: var(--space-4); font-size: 1.3rem; color: var(--color-text);">Collaborators</h3>
                <div class="field-journal-grid">
                    {{#get "posts" filter="tag:hash-team-collaborators" limit="100" include="tags"}}
                        {{#foreach posts}}
                            {{> "card-team"}}
                        {{else}}
                            <p class="mono text-muted">No members listed yet.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>

        </div>
    </section>
    </div>
    {{> "dynamic-sections"}}
</article>


{{/post}}
