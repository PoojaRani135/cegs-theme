{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
        {{content}}
    </div>

    <h2 class="editorial-title text-center" style="margin-bottom: var(--space-4);">Submit Application</h2>
    <div class="writing-pad-wrapper">
        <div class="clipboard-clip"></div>
        <form action="{{@custom.opportunity_form_endpoint}}" method="POST" class="writing-pad">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required />
            </div>
            
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required />
            </div>

            <div class="form-group">
                <label for="position">Role of Interest</label>
                <input type="text" id="position" name="position" placeholder="e.g. Research Assistant, Field Biologist" required />
            </div>
            
            <div class="form-group">
                <label for="cover_letter">Statement of Interest / Cover Letter</label>
                <textarea id="cover_letter" name="cover_letter" rows="8" required></textarea>
            </div>
            
            <div class="form-group" style="margin-bottom: 0;">
                <label for="portfolio_link">Portfolio / CV Link (Optional)</label>
                <input type="url" id="portfolio_link" name="portfolio_link" />
            </div>
            
            <div style="text-align: center; margin-top: 32px;">
                <button type="submit" class="stamp-button">Submit Application</button>
            </div>
        </form>
    </div>
</article>
{{/post}}
