{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <header class="post-header editorial-header text-center">
        <h1 class="post-title">{{title}}</h1>
        {{#if feature_image}}
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager" />
            </figure>
        {{/if}}
    </header>

    <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
        {{content}}
    </div>

    <section class="opportunities-form-section mt-8 mb-8" style="max-width: 600px;">
        <h2 class="editorial-title" style="margin-bottom: var(--space-4);">Submit Application</h2>
        <form action="{{@custom.opportunities_form_endpoint}}" method="POST" class="cegs-form field-journal-card" style="padding: var(--space-5);">
            <div class="form-group" style="margin-bottom: var(--space-4);">
                <label for="name" class="mono" style="display: block; margin-bottom: var(--space-2);">Full Name</label>
                <input type="text" id="name" name="name" required style="width: 100%; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg-base);" />
            </div>
            
            <div class="form-group" style="margin-bottom: var(--space-4);">
                <label for="email" class="mono" style="display: block; margin-bottom: var(--space-2);">Email Address</label>
                <input type="email" id="email" name="email" required style="width: 100%; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg-base);" />
            </div>

            <div class="form-group" style="margin-bottom: var(--space-4);">
                <label for="position" class="mono" style="display: block; margin-bottom: var(--space-2);">Role of Interest</label>
                <input type="text" id="position" name="position" placeholder="e.g. Research Assistant, Field Biologist" required style="width: 100%; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg-base); font-family: var(--font-family-body);" />
            </div>
            
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label for="cover_letter" class="mono" style="display: block; margin-bottom: var(--space-2);">Statement of Interest / Cover Letter</label>
                <textarea id="cover_letter" name="cover_letter" rows="8" required style="width: 100%; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 2px; font-family: var(--font-family-body); background: var(--color-bg-base);"></textarea>
            </div>
            
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label for="portfolio_link" class="mono" style="display: block; margin-bottom: var(--space-2);">Portfolio / CV Link (Optional)</label>
                <input type="url" id="portfolio_link" name="portfolio_link" style="width: 100%; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg-base);" />
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%;">Submit Application</button>
        </form>
    </section>
</article>
{{/post}}
