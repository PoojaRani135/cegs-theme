{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container mt-6 mb-8">
    <header class="post-header editorial-layout text-center mb-6">
        {{#if primary_tag}}
            <span class="post-tag mono text-muted" style="text-transform: uppercase;">{{primary_tag.name}}</span>
        {{/if}}
        <h1 class="post-title editorial-title mt-2">{{title}}</h1>
        <div class="post-meta mono mt-3 text-muted">
            By {{authors separator=", "}} &middot; <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post-feature-image editorial-layout mb-6" style="max-width: 1000px;">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="width: 100%; border-radius: var(--radius-sm);" />
            {{#if feature_image_caption}}
                <figcaption class="mono text-muted text-center mt-2">{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <div class="post-content editorial-layout drop-cap">
        {{content}}
    </div>
</article>
{{/post}}
