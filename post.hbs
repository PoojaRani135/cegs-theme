{{!< default}}
<!-- TEST RELOAD -->

{{#post}}
{{#has tag="#team-governing,#team-research,#team-advisory,#team-ground-staff,#team-collaborator"}}
<article class="container {{post_class}} single-post-container mt-6 mb-8">
    <div class="team-bio-grid{{^if feature_image}} no-image{{/if}}">
        {{#if feature_image}}
        <div class="team-bio-photo-column">
            <div class="team-bio-polaroid">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" />
            </div>
        </div>
        {{/if}}
        <div class="team-bio-content-column">
            <header class="post-header text-left mb-4">
                <h1 class="post-title editorial-title mt-0">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="mono team-bio-role">{{custom_excerpt}}</p>
                {{/if}}
            </header>
            <div class="post-content drop-cap" style="max-width: 100%;">
                {{content}}
            </div>
        </div>
    </div>
</article>
{{else}}
<article class="container {{post_class}} single-post-container mt-6 mb-8">
    {{#if feature_image}}
        <div class="post-fixed-background" style="background-image: url('{{img_url feature_image size="xl"}}');"></div>
        <script>document.body.classList.add('has-fixed-bg');</script>
    {{/if}}
    
    <div class="post-glass-content">
        <header class="post-header editorial-layout text-center mb-6">
            {{#if primary_tag}}
                <span class="post-tag mono text-muted" style="text-transform: uppercase;">{{primary_tag.name}}</span>
            {{/if}}
            <h1 class="post-title editorial-title mt-2">{{title}}</h1>
            <div class="post-meta mono mt-3 text-muted">
                By {{authors separator=", "}} &middot; <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
            </div>
            {{#if feature_image_caption}}
                <figcaption class="mono text-muted text-center mt-6" style="padding-top: var(--space-4);">{{feature_image_caption}}</figcaption>
            {{/if}}
        </header>

    <div class="post-content editorial-layout drop-cap">
        {{content}}
    </div>
    </div>
</article>
{{/has}}

<!-- PDF Preview Modal (Applies to any PDF link on the post page) -->
<div id="pdf-preview-modal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <button id="pdf-close-btn" class="modal-close" aria-label="Close Preview">&times;</button>
        <div class="modal-content">
            <iframe id="pdf-iframe" src="" frameborder="0" width="100%" height="100%"></iframe>
        </div>
    </div>
</div>

{{/post}}

{{#contentFor "scripts"}}
<script>
    (function() {
        // PDF Modal Logic for Post Page
        // Targets links to PDFs inside Ghost File Cards or general content
        const pdfLinks = document.querySelectorAll('.post-content a[href$=".pdf"]');
        const pdfModal = document.getElementById('pdf-preview-modal');
        const pdfIframe = document.getElementById('pdf-iframe');
        const closeBtn = document.getElementById('pdf-close-btn');

        if (pdfModal && closeBtn && pdfLinks.length > 0) {
            pdfLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault(); // Stop navigation/download
                    pdfIframe.src = this.href;
                    pdfModal.style.display = 'flex';
                    document.body.style.overflow = 'hidden'; // prevent scrolling behind modal
                });
            });

            closeBtn.addEventListener('click', function() {
                pdfModal.style.display = 'none';
                pdfIframe.src = '';
                document.body.style.overflow = '';
            });

            // Close when clicking the dark overlay background
            pdfModal.addEventListener('click', function(e) {
                if (e.target === pdfModal) {
                    pdfModal.style.display = 'none';
                    pdfIframe.src = '';
                    document.body.style.overflow = '';
                }
            });
        }
    })();
</script>
{{/contentFor}}
