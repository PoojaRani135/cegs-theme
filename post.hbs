{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container mt-6 mb-8">
    {{#if feature_image}}
        <figure class="post-feature-image editorial-layout mb-6 text-center" style="max-width: 850px; margin-left: auto; margin-right: auto;">
            <div style="position: relative;">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="width: 100%; border-radius: var(--radius-md); display: block;" />
                <div class="post-header-overlay" style="position: absolute; bottom: var(--space-5); left: 50%; transform: translateX(-50%); width: 90%;">
                    <header class="post-header" style="margin-bottom: 0;">
                        {{#if primary_tag}}
                            <span class="post-tag mono" style="text-transform: uppercase;">{{primary_tag.name}}</span>
                        {{/if}}
                        <h1 class="post-title editorial-title mt-2">{{title}}</h1>
                        <div class="post-meta mono mt-3">
                            By {{authors separator=", "}} &middot; <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
                        </div>
                    </header>
                </div>
            </div>
            {{#if feature_image_caption}}
                <figcaption class="mono text-muted text-center mt-6" style="padding-top: var(--space-4);">{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{else}}
        <header class="post-header editorial-layout text-center mb-6">
            {{#if primary_tag}}
                <span class="post-tag mono text-muted" style="text-transform: uppercase;">{{primary_tag.name}}</span>
            {{/if}}
            <h1 class="post-title editorial-title mt-2">{{title}}</h1>
            <div class="post-meta mono mt-3 text-muted">
                By {{authors separator=", "}} &middot; <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
            </div>
        </header>
    {{/if}}

    <div class="post-content editorial-layout drop-cap">
        {{content}}
    </div>
</article>
{{/post}}
