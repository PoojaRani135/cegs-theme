{{!< default}}

{{!-- 6.1 Hero / Sliding Photos --}}
<section class="hero-slider effect-god-ray" aria-label="Featured Photography">
    <svg class="hero-top-border" width="100%" height="20" preserveAspectRatio="none"><use href="#icon-hanging-vine"></use></svg>
    <div class="slider-container">
        {{#get "posts" filter="tag:hash-hero" limit="all"}}
            {{#foreach posts}}
            <div class="slide {{#if @first}}active{{/if}}">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="{{#if @first}}eager{{else}}lazy{{/if}}" />
                {{/if}}
                <div class="slide-content-overlay">
                    <div class="container">
                        <div class="slide-caption">{{title}}</div>
                    </div>
                </div>
                {{#if custom_excerpt}}
                    <div class="slide-credit mono">{{custom_excerpt}}</div>
                {{/if}}
            </div>
            {{/foreach}}
        {{else}}
            {{!-- Fallback if no hero posts exist --}}
            <div class="slide active">
                <div class="slide-caption">Welcome to CEGS</div>
            </div>
        {{/get}}
    </div>
    <div class="slider-controls">
        <button id="slider-prev" aria-label="Previous slide">❮</button>
        <button id="slider-next" aria-label="Next slide">❯</button>
    </div>
</section>

<div class="container">
    {{!-- 6.2 CEGS Introduction --}}
    <section class="home-section intro-section">
        <div class="section-content home-welcome-intro">
            {{#get "pages" filter="slug:home-intro" limit="1"}}
                {{#foreach pages}}
                    <div class="welcome-text">
                        {{content}}
                    </div>
                {{/foreach}}
            {{else}}
                <p class="lead">Please create a page with the slug <code>home-intro</code> to display content here.</p>
            {{/get}}
            <div class="action-wrap">
                <a href="/about/" class="btn btn-primary">Learn more about us</a>
            </div>
        </div>
    </section>

    {{!-- 6.3 The Case for the Eastern Ghats (Preview Card) --}}
    <section class="home-section case-preview-section">
        <!-- Hidden Ghost content to parse -->
        <div id="case-raw-content" style="display: none;">
            {{#get "pages" filter="slug:home-case" limit="1"}}
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}
            {{/get}}
        </div>
        
        <!-- Hidden Stats content to parse -->
        <div id="stats-raw-content" style="display: none;">
            {{#get "pages" filter="slug:home-case-stats" limit="1"}}
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}
            {{/get}}
        </div>
        
        <div class="case-preview-card card text-card">
            <div class="case-preview-content">
                <span class="eyebrow">The Case for the Eastern Ghats</span>
                <div id="case-preview-text" class="preview-text drop-cap">
                    <!-- Populated via JS -->
                    <p class="mono text-muted">Loading excerpt...</p>
                </div>
                {{#get "pages" filter="slug:home-case" limit="1"}}
                    {{#foreach pages}}
                        <a href="{{url}}" class="read-full-story">Read full story &rarr;</a>
                    {{/foreach}}
                {{/get}}
            </div>
            <div class="case-preview-stats">
                <div class="stats-glow-bg"></div>
                <div id="case-preview-chips" class="preview-chips-container">
                    <!-- Stat chips populated via JS -->
                </div>
            </div>
        </div>
    </section>

    {{!-- Interactive Map --}}
    {{> "interactive-map"}}

    {{!-- 6.4 Featured Research --}}
    <section class="home-section research-section">
        <div class="section-header editorial-header">
            <h2>Featured Research</h2>
            <a href="/research/" class="view-all mono">View all projects &rarr;</a>
        </div>
        <div class="card-grid">
            {{#get "posts" filter="tag:research" limit="all" include="tags"}}
                {{#foreach posts}}
                    {{> "card-research"}}
                {{else}}
                    <p class="mono text-muted">Research projects will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- 6.5 Publications --}}
    <section class="home-section publications-section">
        <div class="section-header editorial-header">
            <h2>Publications</h2>
            <a href="/publications/" class="view-all mono">View all publications &rarr;</a>
        </div>
        <div class="card-grid">
            {{#get "posts" filter="tag:publication" limit="all"}}
                {{#foreach posts}}
                    {{> "card-publication"}}
                {{else}}
                    <p class="mono text-muted">Publications will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- 6.6 Advisory Board and Institutional Collaborations --}}
    <section class="home-section board-section">
        <div class="section-header editorial-header">
            <h2>Advisory Board & Collaborators</h2>
        </div>
        <div class="team-grid field-journal-grid">
            {{#get "posts" filter="tag:hash-team" limit="all" include="tags"}}
                {{#foreach posts}}
                    {{> "card-team"}}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>

{{#contentFor "scripts"}}
<script src="{{asset "js/case-preview.js"}}"></script>
{{/contentFor}}
