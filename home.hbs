{{!< default}}

{{!-- 6.1 Hero / Sliding Photos --}}
<section class="hero-slider" aria-label="Featured Photography">
    <div class="slider-container">
        {{#get "posts" filter="tag:hash-hero" limit="all"}}
            {{#foreach posts}}
            <div class="slide {{#if @first}}active{{/if}}">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="{{#if @first}}eager{{else}}lazy{{/if}}" />
                {{/if}}
                <div class="slide-content-overlay">
                    <div class="container">
                        <div class="slide-caption">{{title}}</div>
                    </div>
                </div>
                {{#if custom_excerpt}}
                    <div class="slide-credit mono">{{custom_excerpt}}</div>
                {{/if}}
            </div>
            {{/foreach}}
        {{else}}
            {{!-- Fallback if no hero posts exist --}}
            <div class="slide active">
                <div class="slide-caption">Welcome to CEGS</div>
            </div>
        {{/get}}
    </div>
    <div class="slider-controls">
        <button id="slider-prev" aria-label="Previous slide">❮</button>
        <button id="slider-next" aria-label="Next slide">❯</button>
    </div>
</section>

<div class="container">
    {{!-- 6.2 CEGS Introduction --}}
    <section class="home-section intro-section editorial-layout">
        <div class="section-content drop-cap">
            {{#get "pages" filter="slug:home-intro" limit="1"}}
                {{#foreach pages}}
                    <div class="editorial-body">
                        {{content}}
                    </div>
                {{/foreach}}
            {{else}}
                <p class="lead">Please create a page with the slug <code>home-intro</code> to display content here.</p>
            {{/get}}
            <div class="action-wrap">
                <a href="/about/" class="btn btn-primary">Learn more about us</a>
            </div>
        </div>
    </section>

    {{!-- 6.3 The Case for the Eastern Ghats --}}
    <section class="home-section case-section">
        <div class="editorial-grid">
            <div class="case-content drop-cap">
                {{#get "pages" filter="slug:home-case" limit="1"}}
                    {{#foreach pages}}
                        <h2 class="section-title editorial-title">{{title}}</h2>
                        <div class="case-excerpt-container">
                            {{content}}
                        </div>
                        <div class="action-wrap mt-5">
                            <a href="{{url}}" class="btn btn-secondary">Read the full case</a>
                        </div>
                    {{/foreach}}
                {{else}}
                    <h2 class="section-title editorial-title">The Case for the Eastern Ghats</h2>
                    <p>Please create a page with the slug <code>home-case</code> to display content here.</p>
                {{/get}}
            </div>
            
            <aside class="case-stats-sidebar">
                <div class="stats-grid">
                    {{#get "pages" filter="slug:home-case-stats" limit="1"}}
                        {{#foreach pages}}
                            {{content}}
                        {{else}}
                            <p class="mono text-muted" style="font-size: 0.85rem;">Create a Page with slug <code>home-case-stats</code>. Separate stats with a divider <code>---</code> and bold the number.</p>
                        {{/foreach}}
                    {{/get}}
                </div>
            </aside>
        </div>
    </section>

    {{!-- 6.4 Featured Research --}}
    <section class="home-section research-section">
        <div class="section-header editorial-header">
            <h2>Featured Research</h2>
            <a href="/research/" class="view-all mono">View all projects &rarr;</a>
        </div>
        <div class="card-grid">
            {{#get "posts" filter="tag:research" limit="all" include="tags"}}
                {{#foreach posts}}
                    {{> "research-card"}}
                {{else}}
                    <p class="mono text-muted">Research projects will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- 6.5 Publications --}}
    <section class="home-section publications-section">
        <div class="section-header editorial-header">
            <h2>Publications</h2>
            <a href="/publications/" class="view-all mono">View all publications &rarr;</a>
        </div>
        <div class="card-grid">
            {{#get "posts" filter="tag:publication" limit="all"}}
                {{#foreach posts}}
                    {{> "publication-card"}}
                {{else}}
                    <p class="mono text-muted">Publications will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- 6.6 Advisory Board and Institutional Collaborations --}}
    <section class="home-section board-section">
        <div class="section-header editorial-header">
            <h2>Advisory Board & Collaborators</h2>
        </div>
        <div class="team-grid field-journal-grid">
            {{#get "posts" filter="tag:hash-team" limit="all" include="tags"}}
                {{#foreach posts}}
                    {{> "team-card"}}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>
