{{!< default}}

{{!-- 6.1 Fullscreen Slider & CEGS Intro --}}
<section class="hero-slider fullscreen-slider" aria-label="Featured Photography">
    <!-- Hidden container for Ghost Gallery -->
    <div id="hero-raw-gallery" style="display: none;">
        {{#get "pages" filter="slug:home-slider" limit="1"}}
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}
        {{/get}}
        {{#get "posts" filter="slug:home-slider" limit="1"}}
            {{#foreach posts}}
                {{{content}}}
            {{/foreach}}
        {{/get}}
    </div>
    <div class="slider-container" id="hero-slider-container">
        <!-- Slides will be injected here via JS from the gallery above -->
    </div>
    
    <div class="slider-dark-overlay">
        <div class="container" style="position: relative; z-index: 10;">
            {{#get "pages" filter="slug:home-intro" limit="1"}}
            {{#foreach pages}}
            <div class="intro-direct-overlay text-center">
                <div class="welcome-text">
                    {{content}}
                </div>
                <div class="action-wrap mt-5">
                    <a href="/about/" class="btn-pill-theme">
                        Learn more about us 
                    </a>
                </div>
            </div>
            {{/foreach}}
            {{else}}
            <div class="intro-direct-overlay text-center">
                <p class="lead" style="color: white;">Please create a page with the slug <code>home-intro</code> to display content here.</p>
            </div>
            {{/get}}
        </div>
    </div>

    <div class="slider-controls">
        <button id="slider-prev" aria-label="Previous slide">❮</button>
        <button id="slider-next" aria-label="Next slide">❯</button>
    </div>
</section>

<div class="container overlap-cards">
    {{!-- 6.3 The Case for the Eastern Ghats (Preview Card) --}}
    <section class="home-section case-preview-section">
        {{#get "pages" filter="slug:home-case" limit="1"}}
        {{#foreach pages}}
        <!-- Hidden Ghost content to parse -->
        <div id="case-raw-content" style="display: none;">
            {{{content}}}
        </div>
        
        <div class="case-preview-card card text-card has-bg-image reveal-on-scroll" {{#if feature_image}}style="background-image: url('{{img_url feature_image size="xl"}}');"{{/if}}>
            <div class="glass-overlay">
                <div class="case-preview-content">
                    <span class="eyebrow">The Case for the Eastern Ghats</span>
                    <div id="case-preview-text" class="preview-text drop-cap">
                        <!-- Populated via JS -->
                        <p class="mono text-muted">Loading excerpt...</p>
                    </div>
                    <a href="{{url}}" class="read-full-story">Read full story &rarr;</a>
                </div>
                <div class="case-preview-stats">
                    <div class="stats-glow-bg"></div>
                    <div id="case-preview-chips" class="preview-chips-container">
                        <!-- Stat chips populated via JS -->
                    </div>
                </div>
            </div>
        </div>
        {{/foreach}}
        {{/get}}

        <!-- Hidden Stats content to parse -->
        <div id="stats-raw-content" style="display: none;">
            {{#get "pages" filter="slug:home-case-stats" limit="1"}}
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- Interactive Map --}}
    {{> "interactive-map"}}

    {{!-- 6.4 Featured Research --}}
    <section class="home-section research-section">
        <div class="section-header editorial-header reveal-on-scroll">
            <h2>Featured Research</h2>
            <a href="/research/" class="view-all mono">View all projects &rarr;</a>
        </div>
        <div class="card-grid reveal-on-scroll reveal-delay-1">
            {{#get "posts" filter="tag:research+featured:true" limit="3" include="tags"}}
                {{#foreach posts}}
                    {{> "card-research"}}
                {{else}}
                    <p class="mono text-muted">Research projects will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- 6.5 Publications --}}
    <section class="home-section publications-section">
        <div class="section-header editorial-header reveal-on-scroll">
            <h2>Publications</h2>
            <a href="/publications/" class="view-all mono">View all publications &rarr;</a>
        </div>
        <div class="card-grid reveal-on-scroll reveal-delay-1">
            {{#get "posts" filter="tag:hash-publication+featured:true" limit="3" include="tags,authors"}}
                {{#foreach posts}}
                    {{> "card-publication"}}
                {{else}}
                    <p class="mono text-muted">Publications will appear here.</p>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{!-- 6.6 Advisory Board and Institutional Collaborations --}}
    <section class="home-section board-section">
        <div class="section-header editorial-header reveal-on-scroll">
            <h2>Advisory board and Institutional collaborations</h2>
        </div>
        <div class="team-grid field-journal-grid reveal-on-scroll reveal-delay-1">
            {{#get "posts" filter="tag:hash-team-advisory" limit="100" include="tags"}}
                {{#foreach posts}}
                    {{> "card-team"}}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>

{{#contentFor "scripts"}}
<script src="{{asset "js/case-preview.js"}}"></script>
{{/contentFor}}
