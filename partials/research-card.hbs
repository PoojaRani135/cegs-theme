<article class="research-card">
    {{#if feature_image}}
    <a class="research-card-image" href="{{url}}">
        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
    </a>
    {{/if}}
    <div class="research-card-content">
        <h3 class="research-card-title"><a href="{{url}}">{{title}}</a></h3>
        <p class="research-card-excerpt">{{excerpt words="20"}}</p>
        <a class="read-more" href="{{url}}">Read More &rarr;</a>
    </div>
</article>
