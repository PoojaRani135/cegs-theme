<svg style="display: none;" xmlns="http://www.w3.org/2000/svg">
    <!-- Base bedrock/strata layers for Act 1 -->
    <symbol id="svg-scrolly-rock" viewBox="0 0 1000 600">
        <path d="M0,600 L1000,600 L1000,300 Q800,200 600,250 T300,400 T0,350 Z" fill="#2d3330" opacity="0.9" />
        <path d="M0,600 L1000,600 L1000,400 Q700,350 500,400 T150,500 T0,450 Z" fill="#232825" />
        <!-- Strata lines -->
        <path d="M0,400 Q300,450 600,300 T1000,350" fill="none" stroke="#38403d" stroke-width="8" stroke-dasharray="40 10" />
        <path d="M0,500 Q500,450 1000,500" fill="none" stroke="#1d221f" stroke-width="12" />
    </symbol>

    <!-- Hill silhouette line for Act 2 -->
    <symbol id="svg-scrolly-hill-path" viewBox="0 0 1000 600">
        <!-- A contiguous path from left to right simulating the Eastern Ghats -->
        <path id="hill-path-line" d="M0,350 Q100,250 200,280 T350,150 T500,200 T700,80 T850,120 T1000,50" 
              fill="none" stroke="var(--color-canopy-light)" stroke-width="4" stroke-linecap="round" />
    </symbol>
    
    <!-- Data Markers for Act 2 / 3 -->
    <symbol id="svg-scrolly-marker" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="6" fill="var(--color-coral)" />
        <circle cx="12" cy="12" r="10" fill="none" stroke="var(--color-coral)" stroke-width="2" opacity="0.5" />
    </symbol>

    <!-- Gecko icon -->
    <symbol id="svg-scrolly-gecko" viewBox="0 0 24 24">
        <!-- Simplified gecko silhouette -->
        <path d="M12,4 C14,4 15,6 15,8 C15,10 13,11 13,13 L13,17 L15,19 L15,20 L13,20 L12,22 L11,20 L9,20 L9,19 L11,17 L11,13 C11,11 9,10 9,8 C9,6 10,4 12,4 Z M16,10 L18,12 L19,11 L20,12 M8,10 L6,12 L5,11 L4,12 M14,15 L16,16 L17,15 L18,16 M10,15 L8,16 L7,15 L6,16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
</svg>
