<svg style="display: none;" xmlns="http://www.w3.org/2000/svg">
    <!-- SVG Sprite Library for CEGS Theme Foliage -->
    
    <symbol id="icon-leaf-cluster" viewBox="0 0 100 100">
        <!-- Abstract flat painterly leaf cluster -->
        <path fill="currentColor" d="M10,90 C10,90 30,50 60,40 C90,30 95,10 95,10 C95,10 80,30 65,45 C50,60 10,90 10,90 Z" />
        <path fill="currentColor" d="M20,95 C20,95 40,70 70,60 C100,50 100,30 100,30 C100,30 90,50 75,65 C60,80 20,95 20,95 Z" opacity="0.7" />
        <path fill="currentColor" d="M5,80 C5,80 20,40 50,30 C80,20 85,5 85,5 C85,5 70,25 55,40 C40,55 5,80 5,80 Z" opacity="0.4" />
    </symbol>

    <symbol id="icon-fern-frond" viewBox="0 0 100 100">
        <!-- Delicate background fern shape -->
        <path fill="currentColor" d="M50,100 Q45,50 90,10 Q60,30 45,70 Q20,40 10,60 Q30,70 40,90 Z" />
        <path fill="currentColor" d="M45,95 Q40,45 85,5 Q55,25 40,65 Q15,35 5,55 Q25,65 35,85 Z" opacity="0.6"/>
    </symbol>

    <symbol id="icon-hanging-vine" viewBox="0 0 200 50">
        <!-- Thin horizontal vine line for borders -->
        <path fill="currentColor" d="M0,10 Q25,30 50,10 T100,10 T150,10 T200,10" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="25" cy="20" r="3" fill="currentColor" />
        <circle cx="75" cy="20" r="2" fill="currentColor" />
        <circle cx="125" cy="20" r="4" fill="currentColor" />
        <circle cx="175" cy="20" r="3" fill="currentColor" />
    </symbol>

    <symbol id="icon-accent-flower" viewBox="0 0 100 100">
        <!-- Elegant Botanical Lotus / Tropical Bloom -->
        <!-- Center petal -->
        <path fill="currentColor" d="M50,90 C50,90 35,60 35,30 C35,15 50,5 50,5 C50,5 65,15 65,30 C65,60 50,90 50,90 Z" opacity="0.9"/>
        <!-- Inner side petals -->
        <path fill="currentColor" d="M50,90 C50,90 20,70 15,40 C10,20 30,15 30,15 C30,15 40,40 50,90 Z" opacity="0.75"/>
        <path fill="currentColor" d="M50,90 C50,90 80,70 85,40 C90,20 70,15 70,15 C70,15 60,40 50,90 Z" opacity="0.75"/>
        <!-- Outer side petals -->
        <path fill="currentColor" d="M50,90 C50,90 5,80 5,55 C5,35 20,30 20,30 C20,30 30,55 50,90 Z" opacity="0.5"/>
        <path fill="currentColor" d="M50,90 C50,90 95,80 95,55 C95,35 80,30 80,30 C80,30 70,55 50,90 Z" opacity="0.5"/>
        <!-- Base leaves -->
        <path fill="currentColor" d="M50,90 C40,95 20,95 10,85 C25,80 40,85 50,90 Z" opacity="0.3"/>
        <path fill="currentColor" d="M50,90 C60,95 80,95 90,85 C75,80 60,85 50,90 Z" opacity="0.3"/>
    </symbol>
</svg>
