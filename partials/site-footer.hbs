<footer class="site-footer">
    <div class="container site-footer-inner">
        <div class="footer-widget">
            <h3>Quick Links</h3>
            {{#if @site.secondary_navigation}}
                {{navigation type="secondary"}}
            {{else}}
                <ul class="nav-list">
                    <li><a href="/research/">Research Programme</a></li>
                    <li><a href="/publications/">Scientific Publications</a></li>
                    <li><a href="/gallery/">Gallery</a></li>
                    <li><a href="/contact/">Contact</a></li>
                </ul>
            {{/if}}
        </div>
        
        <div class="footer-widget">
            <h3>Contact</h3>
            <p>{{@site.title}}</p>
            {{#if @custom.footer_contact_address}}
                <p>{{@custom.footer_contact_address}}</p>
            {{/if}}
            {{#if @custom.footer_contact_email}}
                <p><a href="mailto:{{@custom.footer_contact_email}}">{{@custom.footer_contact_email}}</a></p>
            {{/if}}
        </div>

        <div class="footer-widget">
            <h3>Follow Us</h3>
            <div class="social-links">
                {{#social_accounts @site}}
                    <a href="{{href}}" target="_blank" rel="noopener noreferrer" aria-label="{{name}}">
                        {{#> (concat "icons/" type)}}
                            <span>{{name}}</span>
                        {{/undefined}}
                    </a>
                {{/social_accounts}}
            </div>
        </div>

        <div class="footer-widget">
            <h3>Support Our Work</h3>
            <a href="/support" class="btn btn-primary">Support Us</a>
        </div>
    </div>
    
    <div class="site-footer-bottom container">
        <div class="copyright">
            &copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.
        </div>
    </div>
</footer>
