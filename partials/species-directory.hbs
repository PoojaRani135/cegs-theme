{{!-- 
    species-directory.hbs
    Species Directory component: fetches and renders posts tagged #species with live client search
--}}
{{#get "posts" filter="tag:hash-species" limit="100" include="tags"}}
    {{#if posts}}
    <section class="species-directory mt-6 mb-8">
        <div class="editorial-header" style="justify-content: flex-end; margin-bottom: var(--space-4); border-bottom: none;">
            <div class="filter-controls">
                <input type="text" id="species-search" class="mono" placeholder="Search by name or taxa..." style="padding: 8px 14px; border: 1px solid var(--color-sand); border-radius: 4px; background: transparent; color: var(--color-text); min-width: 250px;">
            </div>
        </div>

        <div class="species-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4);">
            {{#foreach posts}}
                <div class="species-card field-journal-card" data-search="{{title}} {{custom_excerpt}}">
                    {{#if feature_image}}
                        <img src="{{img_url feature_image size="s" format="webp"}}" alt="{{title}}" style="width: 200px; height: 200px; object-fit: cover; border-radius: var(--radius-sm); filter: sepia(0.1); margin-bottom: var(--space-3);" loading="lazy" />
                    {{/if}}
                    <h3 style="margin-bottom: 4px;">{{title}}</h3>
                    <p class="mono text-muted" style="font-style: italic; font-size: 0.9em; margin-bottom: var(--space-2);">{{custom_excerpt}}</p>
                    <div class="species-role" style="font-size: 0.9em;">
                        {{content}}
                    </div>
                </div>
            {{/foreach}}
        </div>
    </section>
    {{/if}}
{{/get}}
