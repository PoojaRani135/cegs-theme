<header class="site-header">
    <div class="container site-header-inner">
        <div class="site-brand">
            <a href="{{@site.url}}" class="site-logo">
                {{#if @site.logo}}
                <img src="{{img_url @site.logo size="s" format="webp"}}" alt="{{@site.title}}" width="100" height="100" />
                {{else}}
                {{@site.title}}
                {{/if}}
            </a>
        </div>

        <nav class="site-nav" aria-label="Main Navigation">
            {{navigation}}
        </nav>

        <div class="header-controls">
            <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Open Mobile Menu" aria-expanded="false" aria-controls="mobile-menu-overlay">
                ☰
            </button>
        </div>
    </div>

    <div id="mobile-menu-overlay" class="mobile-menu-overlay" aria-hidden="true">
        <nav class="mobile-nav" aria-label="Mobile Navigation">
            {{navigation}}
        </nav>
    </div>
</header>