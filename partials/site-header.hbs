<header class="site-header">
    <div class="container site-header-inner">
        <div class="site-brand">
            <a href="{{@site.url}}" class="site-logo">
                {{#if @site.logo}}
                <img src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}" />
                {{else}}
                {{@site.title}}
                {{/if}}
            </a>
        </div>

        <nav class="site-nav" aria-label="Main Navigation">
            {{navigation}}
        </nav>

        <div class="header-controls">
            <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Open Mobile Menu">
                ☰
            </button>
        </div>
    </div>
</header>

<div id="mobile-menu-overlay" class="mobile-menu-overlay" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="nav-list">
            {{#foreach @site.navigation}}
            <li class="nav-item nav-{{slug}}">
                <a href="{{url absolute=" true"}}">{{label}}</a>
            </li>
            {{/foreach}}
        </ul>
    </nav>
</div>