<article class="card card-publication {{post_class}} stagger-in">
    <a href="{{url}}" class="card-link-wrapper" style="text-decoration: none; color: inherit; display: block; width: 100%; height: 100%;">
        <div class="card-content">
            <div class="publication-meta">
                <span class="publication-year">{{date format="YYYY"}}</span>
                {{#if tags}}
                    <span class="publication-separator">•</span>
                    <span class="publication-category">{{tags separator=", " autolink="false"}}</span>
                {{/if}}
            </div>

            <h3 class="card-title">
                {{title}}
            </h3>
            
            <div class="card-authors mono">
                {{authors separator=", " autolink="false"}}
            </div>
            
            {{#if custom_excerpt}}
            <p class="card-journal">{{custom_excerpt}}</p>
            {{/if}}
        </div>
    </a>
</article>
