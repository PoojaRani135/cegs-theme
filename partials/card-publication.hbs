<article class="card card-publication {{post_class}} stagger-in">
    <a href="{{url}}" class="card-link-wrapper" style="text-decoration: none; color: inherit; display: block; width: 100%; height: 100%;">
        <div class="card-content">
            <div class="publication-meta">
                {{#if tags}}
                    <span class="publication-category">{{tags separator=", " autolink="false"}}</span>
                {{/if}}
            </div>

            <h3 class="card-title">
                {{title}}
            </h3>
            <p class="card-summary" style="margin-top: var(--space-3); color: var(--color-text-main);">
                {{excerpt words="30"}}
            </p>
        </div>
    </a>
</article>
