{{!-- 
    card-team.hbs
--}}
<article class="card-team-polaroid {{post_class}} stagger-in">
    <a href="{{url}}" class="polaroid-image{{^if feature_image}} no-photo{{/if}}">
        {{#if feature_image}}
        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
        {{/if}}
    </a>
    
    <div class="polaroid-content">
        <h3 class="polaroid-title">{{title}}</h3>
        
        {{#if custom_excerpt}}
        <p class="polaroid-subtitle mono">{{custom_excerpt}}</p>
        {{/if}}
        
        <a href="{{url}}" class="polaroid-read-more mono">Read Bio &rarr;</a>
    </div>
</article>
