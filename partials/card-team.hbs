{{!-- 
    card-team.hbs
--}}
{{#if feature_image}}
<article class="card-team-polaroid {{post_class}} stagger-in">
    <a href="{{url}}" class="polaroid-image">
        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
    </a>
    
    <div class="polaroid-content">
        <h3 class="polaroid-title">{{title}}</h3>
        
        {{#if custom_excerpt}}
        <p class="polaroid-subtitle mono">{{custom_excerpt}}</p>
        {{/if}}
        
        <a href="{{url}}" class="polaroid-read-more mono">Read Bio &rarr;</a>
    </div>
</article>
{{else}}
<article class="card-team-nameplate {{post_class}} stagger-in">
    <div class="nameplate-content">
        <h3 class="nameplate-title">{{title}}</h3>
        
        {{#if custom_excerpt}}
        <p class="nameplate-subtitle mono">{{custom_excerpt}}</p>
        {{/if}}
        
        <a href="{{url}}" class="nameplate-read-more mono">Read Bio &rarr;</a>
    </div>
</article>
{{/if}}
