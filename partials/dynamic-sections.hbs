{{!-- Dynamic Sections System --}}
{{!-- Automatically fetches any Pages that are tagged with #<page-slug>-section --}}
{{#get "pages" filter="tag:hash-{{slug}}-section" order="published_at asc" include="tags"}}
    {{#if pages}}
        <div class="dynamic-sections mt-8">
            {{#foreach pages}}
            <section class="dynamic-page-section mb-8">
                <div class="post-glass-content">
                    <header class="post-header editorial-header text-center">
                        <h2 class="post-title">{{title}}</h2>
                        {{#if feature_image}}
                            <figure class="post-feature-image mt-4" style="margin-bottom: var(--space-4);">
                                <img 
                                    srcset="{{img_url feature_image size="s" format="webp"}} 300w,
                                            {{img_url feature_image size="m" format="webp"}} 600w,
                                            {{img_url feature_image size="l" format="webp"}} 1000w,
                                            {{img_url feature_image size="xl" format="webp"}} 2000w"
                                    sizes="(max-width: 1000px) 100vw, 1000px"
                                    src="{{img_url feature_image size="l" format="webp"}}" 
                                    alt="{{title}}" 
                                    loading="lazy" 
                                    width="1000"
                                    height="600"
                                    style="border-radius: var(--radius-md); box-shadow: 0 4px 15px rgba(0,0,0,0.1);" />
                            </figure>
                        {{/if}}
                    </header>
                    
                    <div class="post-content editorial-layout mt-5">
                        {{content}}
                    </div>
                    
                    {{#has tag="#species,#species-directory,hash-species,hash-species-directory"}}
                        {{> "species-directory"}}
                    {{else}}
                        {{#match title "=" "Species Directory"}}
                            {{> "species-directory"}}
                        {{else}}
                            {{#match slug "=" "species-directory"}}
                                {{> "species-directory"}}
                            {{else}}
                                {{#match slug "=" "nursery-restoration-section"}}
                                    {{> "species-directory"}}
                                {{/match}}
                            {{/match}}
                        {{/match}}
                    {{/has}}
                </div>
            </section>
            {{/foreach}}
        </div>
    {{/if}}
{{/get}}
