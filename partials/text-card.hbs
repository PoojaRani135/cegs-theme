{{!-- 
    text-card.hbs
--}}
<article class="card text-card {{#if dropcap}}drop-cap{{/if}} stagger-in container-read">
    <div class="card-content">
        {{#if title}}
        <h2 class="card-title">{{title}}</h2>
        {{/if}}
        
        {{content}}
    </div>
    
    <svg class="card-hover-leaf" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 22C12 22 4 16 4 10C4 6 7 4 12 4C17 4 20 6 20 10C20 16 12 22 12 22Z"/>
        <path d="M12 22V10"/>
    </svg>
</article>
