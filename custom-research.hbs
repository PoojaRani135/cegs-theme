{{!< default}}

{{#post}}
<article class="container {{post_class}} single-post-container">
    <div class="post-glass-content">
        {{> "page-header"}}

        <div class="post-content editorial-layout drop-cap mt-5 mb-6 text-center">
            {{content}}
        </div>

        <section class="research-projects" style="margin-top: var(--space-6); margin-bottom: var(--space-8);">
            <div class="card-grid">
                {{#get "posts" filter="tag:research" limit="all" include="tags"}}
                    {{#foreach posts}}
                        {{> "card-research"}}
                    {{/foreach}}
                {{/get}}
            </div>
        </section>
    </div>
</article>
{{/post}}
